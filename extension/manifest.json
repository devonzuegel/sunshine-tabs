{
  "manifest_version": 3,
  "name": "Sunshine Tabs",
  "version": "1.0.0",
  "description": "Connect this Chrome profile to your local tab dashboard.",
  "key": "",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "favicon", "debugger"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "incognito": "not_allowed"
}
